<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Kamisaki - Consultoría operativa, optimización empresarial y transformación digital.">
    <title>Kamisakiy | Consultoría Empresarial</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --cafe-oscuro: #3b2418;
            --cafe: #5a3825;
            --cafe-medio: #79543b;
            --caramelo: #a9784d;
            --dorado: #c49a6c;
            --crema: #f7f0e7;
            --blanco: #fffdf9;
            --gris: #6d625a;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--crema);
            color: var(--dorado);
            line-height: 1.6;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(59, 36, 24, 0.97);
            padding: 17px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 3px 15px rgba(0,0,0,.18);
        }

        .logo {
            font-size: 30px;
            font-weight: 800;
            color: #fff;
            letter-spacing: 2px;
        }

        .logo span {
            color: var(--dorado);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 28px;
        }

        nav a {
            text-decoration: none;
            color: #fff;
            font-size: 15px;
            transition: .3s;
        }

        nav a:hover {
            color: var(--dorado);
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            padding: 150px 8% 80px;
            display: flex;
            align-items: center;
            background:
                linear-gradient(110deg, rgba(59,36,24,.98), rgba(90,56,37,.90)),
                radial-gradient(circle at 80% 20%, #b78b5c, transparent 30%);
            color: white;
        }

        .hero-content {
            max-width: 850px;
        }

        .tag {
            display: inline-block;
            border: 1px solid var(--dorado);
            color: #e8c79d;
            padding: 8px 17px;
            border-radius: 30px;
            margin-bottom: 22px;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .hero h1 {
            font-size: clamp(48px, 8vw, 86px);
            line-height: .95;
            margin-bottom: 25px;
        }

        .hero h1 span {
            color: var(--dorado);
        }

        .hero p {
            max-width: 700px;
            font-size: 20px;
            color: #eee2d5;
            margin-bottom: 35px;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            background: var(--dorado);
            color: var(--cafe-oscuro);
            text-decoration: none;
            font-weight: 700;
            border-radius: 7px;
            transition: .3s;
        }

        .btn:hover {
            background: #e0bd92;
            transform: translateY(-3px);
        }

        .btn-outline {
            margin-left: 10px;
            background: transparent;
            border: 1px solid #d6b38b;
            color: white;
        }

        /* GENERAL */
        section {
            padding: 90px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title small {
            color: var(--caramelo);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .section-title h2 {
            font-size: 40px;
            margin-top: 8px;
        }

        .section-title p {
            max-width: 700px;
            margin: 12px auto;
            color: var(--gris);
        }

        /* PRESENTACION */
        .presentation {
            background: var(--blanco);
        }

        .presentation-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 55px;
            align-items: center;
        }

        .presentation-text h3 {
            font-size: 31px;
            margin-bottom: 18px;
        }

        .presentation-text p {
            color: var(--gris);
            margin-bottom: 17px;
        }

        .highlight {
            background: var(--crema);
            border-left: 5px solid var(--dorado);
            padding: 22px;
            border-radius: 8px;
            margin-top: 25px;
        }

        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .stat {
            background: var(--cafe);
            color: white;
            padding: 35px 25px;
            border-radius: 14px;
            box-shadow: 0 10px 25px rgba(59,36,24,.15);
        }

        .stat h3 {
            font-size: 26px;
            color: var(--dorado);
            margin-bottom: 7px;
        }

        /* PROBLEMA */
        .problem {
            background: var(--cafe-oscuro);
            color: white;
        }

        .problem .section-title p {
            color: #d9c9bb;
        }

        .problem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .problem-card {
            padding: 35px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 12px;
            background: rgba(255,255,255,.04);
        }

        .problem-card .icon {
            font-size: 34px;
            margin-bottom: 15px;
        }

        .problem-card h3 {
            color: var(--dorado);
            margin-bottom: 12px;
        }

        .problem-card p {
            color: #ded3c9;
        }

        /* SERVICIOS */
        .services {
            background: var(--crema);
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .service-card {
            background: white;
            padding: 35px 28px;
            border-radius: 14px;
            border-top: 5px solid var(--cafe);
            box-shadow: 0 8px 25px rgba(59,36,24,.08);
            transition: .3s;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(59,36,24,.16);
        }

        .number {
            font-size: 45px;
            font-weight: 800;
            color: #e3d4c5;
        }

        .service-card h3 {
            margin: 8px 0 12px;
            font-size: 22px;
        }

        .service-card h4 {
            color: var(--caramelo);
            margin-bottom: 15px;
        }

        .service-card ul {
            list-style: none;
            color: var(--gris);
        }

        .service-card li {
            margin: 9px 0;
            padding-left: 20px;
            position: relative;
        }

        .service-card li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--caramelo);
            font-weight: bold;
        }

        /* PASO */
        .paso {
            background: white;
        }

        .paso-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .paso-card {
            position: relative;
            padding: 32px 25px;
            background: var(--crema);
            border-radius: 12px;
            text-align: center;
        }

        .paso-letter {
            width: 65px;
            height: 65px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--cafe);
            color: white;
            border-radius: 50%;
            font-size: 27px;
            font-weight: bold;
        }

        .paso-card h3 {
            margin-bottom: 10px;
        }

        .paso-card p {
            color: var(--gris);
            font-size: 14px;
        }

        /* OPORTUNIDAD */
        .opportunity {
            background: linear-gradient(135deg, var(--cafe), var(--cafe-oscuro));
            color: white;
            text-align: center;
        }

        .opportunity-content {
            max-width: 850px;
            margin: auto;
        }

        .opportunity h2 {
            font-size: 42px;
            margin-bottom: 20px;
        }

        .opportunity p {
            font-size: 19px;
            color: #e5d8cc;
        }

        .quote {
            margin: 35px 0;
            padding: 25px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 10px;
            font-size: 23px;
            font-style: italic;
            color: #f0d5b4;
        }

        /* CLIENTES */
        .clients {
            background: var(--blanco);
        }

        .client-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            max-width: 950px;
            margin: auto;
        }

        .client-card {
            padding: 35px;
            border-radius: 12px;
            background: var(--crema);
        }

        .client-card h3 {
            margin-bottom: 12px;
            font-size: 23px;
        }

        .client-card p {
            color: var(--gris);
        }

        /* CTA */
        .cta {
            padding: 80px 8%;
            background: var(--dorado);
            text-align: center;
            color: var(--cafe-oscuro);
        }

        .cta h2 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .cta p {
            max-width: 650px;
            margin: 0 auto 28px;
            font-size: 18px;
        }

        .cta .btn {
            background: var(--cafe-oscuro);
            color: white;
        }

        /* FOOTER */
        footer {
            background: #281810;
            color: #cfc1b5;
            padding: 45px 8% 25px;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer-logo {
            color: white;
            font-size: 27px;
            font-weight: bold;
        }

        .footer-logo span {
            color: var(--dorado);
        }

        footer p {
            max-width: 450px;
            margin-top: 10px;
        }

        .footer-links a {
            color: #cfc1b5;
            text-decoration: none;
            margin-left: 18px;
        }

        .copyright {
            border-top: 1px solid rgba(255,255,255,.1);
            padding-top: 20px;
            text-align: center;
            font-size: 13px;
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            nav ul {
                display: none;
            }

            .presentation-grid,
            .problem-grid,
            .client-grid {
                grid-template-columns: 1fr;
            }

            .service-grid {
                grid-template-columns: 1fr;
            }

            .paso-grid {
                grid-template-columns: 1fr 1fr;
            }

            .hero {
                padding-top: 130px;
            }
        }

        @media (max-width: 600px) {
            section {
                padding: 65px 6%;
            }

            .hero {
                padding-left: 6%;
                padding-right: 6%;
            }

            .hero h1 {
                font-size: 55px;
            }

            .hero p {
                font-size: 17px;
            }

            .btn {
                display: block;
                text-align: center;
                margin: 10px 0;
            }

            .btn-outline {
                margin-left: 0;
            }

            .paso-grid,
            .stats {
                grid-template-columns: 1fr;
            }

            .footer-content {
                flex-direction: column;
            }

            .footer-links a {
                margin-left: 0;
                margin-right: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVEGACIÓN -->
    <nav>
        <div class="logo">KAMISAKI<span>.</span></div>

        <ul>
            <li><a href="#inicio">Inicio</a></li>
