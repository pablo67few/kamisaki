            <li><a href="#contacto">Contacto</a></li>
        </ul>
    </nav>


    <!-- INICIO -->
    <section class="hero" id="inicio">
        <div class="hero-content">

            <span class="tag">CONSULTORÍA OPERATIVA Y EMPRESARIAL</span>

            <h1>
                Convierte tu<br>
                <span>idea en realidad.</span>
            </h1>

            <p>
                Acompañamos a emprendedores y empresas a transformar sus
                ideas, optimizar sus operaciones y aumentar su rentabilidad
